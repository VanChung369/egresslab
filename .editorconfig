root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Reference material kept byte-for-byte as committed: don't let editors rewrite it.
[{README.md,docs/**,design/**}]
insert_final_newline = unset
trim_trailing_whitespace = unset
